{:min-bb-version "1.3.0"

 :paths ["."]

 :tasks
 {:requires ([babashka.process :as p]
             [babashka.fs :as fs]
             [clojure.edn :as edn]
             [clojure.string :as str]
             [bb.helpers :as h])

  ;; =============================================================================
  ;; 🔧 Development
  ;; =============================================================================

  repl
  {:doc "🔧 Start Clojure REPL for interactive development"
   :override-builtin true
   :task (do
           (h/header "🔧 Starting Clojure REPL")
           (h/info "Starts a plain REPL. The demos live in raylib-clj-demo: https://github.com/b12n-oss/raylib-clj-demo")
           (p/shell "clj"))}

  nrepl
  {:doc "🔧 Start nREPL server on port 7999 (for non-GUI work)"
   :task (do
           (h/header "🔧 Starting nREPL Server")
           (h/info "nREPL listening on port 7999 (standalone, non-GUI work)")
           (h/info "For live game dev, run a game from raylib-clj-demo and connect to port 7888")
           (p/shell "clojure" "-M:dev"))}

  ;; =============================================================================
  ;; 🔍 Code Quality
  ;; =============================================================================

  lint
  {:doc "🔍 Run clj-kondo linter"
   :task (do
           (h/header "🔍 Running clj-kondo Linter")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (if (zero? exit)
               (h/success "No lint errors!")
               (System/exit exit))))}

  whitespace:check
  {:doc "🧹 Check src/ for trailing whitespace (the kind Emacs highlights in red)"
   ;; cljfmt/clojure-lsp never touch this: trailing spaces on a blank line
   ;; inside a docstring are part of the string literal's content, so a
   ;; formatter that only rewrites code structure leaves them untouched.
   :task (let [files (sort (map str (fs/glob "src" "**.{clj,cljc,cljd,cljs}")))
               ;; (?m) makes $ match before every line terminator, not just
               ;; end-of-file - that's what reaches blank lines mid-docstring.
               ws-re (re-pattern "(?m)[ \\t]+$")
               dirty (filter (fn [f] (re-find ws-re (slurp f))) files)]
           (h/header "🧹 Checking Trailing Whitespace")
           (if (empty? dirty)
             (h/success "No trailing whitespace in src/!")
             (do
               (doseq [f dirty] (println (str "  " f)))
               (h/warn (str (count dirty) " file(s) with trailing whitespace"))
               (h/info "Run 'bb whitespace:fix' to fix")
               (System/exit 1))))}

  whitespace:fix
  {:doc "🧹 Strip trailing whitespace from every line under src/"
   :task (let [files (sort (map str (fs/glob "src" "**.{clj,cljc,cljd,cljs}")))
               ws-re (re-pattern "(?m)[ \\t]+$")
               fix! (fn [f]
                      (let [orig (slurp f)
                            cleaned (str/replace orig ws-re "")]
                        (when (not= orig cleaned)
                          (spit f cleaned)
                          f)))
               changed (keep fix! files)]
           (h/header "🧹 Stripping Trailing Whitespace")
           (if (empty? changed)
             (h/success "Nothing to fix - src/ is already clean!")
             (do
               (doseq [f changed] (println (str "  fixed " f)))
               (h/success (str "Fixed " (count changed) " file(s)"))
               (h/info "Review the diff, then commit"))))}

  check
  {:doc "⭐ Fast checks (compile every namespace + lint) - use before committing"
   :task (do
           (h/header "🔍 Running Fast Checks")
           (h/step 1 "Compile check (every namespace under src/)...")
           (p/shell "clojure" "-M:check")
           (println)
           (h/step 2 "Lint check...")
           ;; clj-kondo exit codes: 0 clean, 2 warnings, 3 errors (verified).
           ;; The gate is ERRORS. CONTRIBUTING.md tells contributors the bar is
           ;; "0 errors", so exit 2 (warnings only) prints and shows up in the
           ;; summary line but does not fail the build.
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (println)
             (cond
               (zero? exit) (h/success "All fast checks passed!")
               (= 2 exit)   (h/warn "Lint warnings found (see above) - not failing; the gate is errors")
               :else        (do (h/error-msg "Lint ERRORS found (see above)")
                                (System/exit exit)))))}

  check:full
  {:doc "🔍 Comprehensive checks (compile + lint + LSP)"
   :task (do
           (h/header "🔍 Running Comprehensive Checks")
           (h/step 1 "Checking compilation...")
           (p/shell "clojure" "-M:check")
           (println)
           (h/step 2 "Running clj-kondo lint...")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (when-not (zero? exit)
               (h/warn "Lint warnings found")))
           (println)
           (h/step 3 "Checking code formatting...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Formatting issues found")
               (h/info "Run 'bb lsp:format' to fix")))
           (println)
           (h/step 4 "Checking namespace forms...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Namespace issues found")
               (h/info "Run 'bb lsp:clean-ns' to fix")))
           (println)
           (h/success "All comprehensive checks complete!")
           (h/info "Fix issues with 'bb lsp:fix' if needed"))}

  ;; =============================================================================
  ;; 🎨 LSP Tasks
  ;; =============================================================================

  lsp:format
  {:doc "🎨 Format all Clojure files"
   :task (do
           (h/header "🎨 Formatting Code")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "Code formatted!")
               (do
                 (h/error-msg "Formatting failed")
                 (System/exit exit)))))}

  lsp:format-check
  {:doc "🎨 Check formatting (dry run)"
   :task (do
           (h/header "🔍 Checking Code Formatting")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "All files properly formatted!")
               (do
                 (h/warn "Files need formatting (see diff above)")
                 (h/info "Run 'bb lsp:format' to fix")
                 (System/exit 1)))))}

  lsp:clean-ns
  {:doc "🧹 Clean and organize ns forms"
   :task (do
           (h/header "🧹 Cleaning Namespace Forms")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "Namespaces cleaned!")
               (do
                 (h/error-msg "clean-ns failed")
                 (System/exit exit)))))}

  lsp:clean-ns-check
  {:doc "🧹 Check ns forms (dry run)"
   :task (do
           (h/header "🔍 Checking Namespace Forms")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "All namespace forms are clean!")
               (do
                 (h/warn "Namespaces need cleaning (see diff above)")
                 (h/info "Run 'bb lsp:clean-ns' to fix")
                 (System/exit exit)))))}

  lsp:diagnostics
  {:doc "🔬 Run clojure-lsp diagnostics"
   :task (do
           (h/header "🔬 Running LSP Diagnostics")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "diagnostics"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "No diagnostics found!")
               (do
                 (h/warn "Diagnostics found (see above)")
                 (System/exit exit)))))}

  lsp:check
  {:doc "🔍 All LSP checks (format + clean-ns + diagnostics)"
   :task (do
           (h/header "🔍 Running All LSP Checks")
           (h/step 1 "Checking code formatting...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Formatting issues found")
               (h/info "Run 'bb lsp:format' to fix")))
           (println)
           (h/step 2 "Checking namespace forms...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Namespace issues found")
               (h/info "Run 'bb lsp:clean-ns' to fix")))
           (println)
           (h/step 3 "Running diagnostics...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "diagnostics"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "All LSP checks passed!")
               (do
                 (h/warn "Some issues found (see above)")
                 (System/exit 1)))))}

  lsp:fix
  {:doc "🔧 Auto-fix format + clean-ns"
   :task (do
           (h/header "🔧 Fixing Code with LSP")
           (h/step 1 "Formatting code...")
           (p/shell {:continue true}
                    "clojure-lsp" "format"
                    "--project-root" (str (fs/cwd)))
           (println)
           (h/step 2 "Cleaning namespaces...")
           (p/shell {:continue true}
                    "clojure-lsp" "clean-ns"
                    "--project-root" (str (fs/cwd)))
           (println)
           (h/success "All auto-fixes applied!")
           (h/info "Run 'bb lsp:diagnostics' to check remaining issues"))}

  ;; =============================================================================
  ;; 🪝 Git Hooks
  ;; =============================================================================

  hooks:install
  {:doc "🪝 Install git pre-commit hook (lint only)"
   :task (do
           (h/header "🪝 Installing Git Pre-commit Hook")
           (let [hook-path ".git/hooks/pre-commit"
                 hook-content "#!/bin/bash
# raylib-clojure-playground pre-commit hook (fast - lint only)
set -e
echo \"🔍 Running pre-commit lint check...\"
clj-kondo --lint src
echo \"✅ Lint check passed!\"
"]
             (spit hook-path hook-content)
             (p/shell "chmod" "+x" hook-path)
             (h/success "Pre-commit hook installed (lint only)")
             (h/info "Hook will run automatically on 'git commit'")
             (h/info "To skip: git commit --no-verify")))}

  hooks:uninstall
  {:doc "🪝 Remove git pre-commit hook"
   :task (let [hook-path ".git/hooks/pre-commit"]
           (if (fs/exists? hook-path)
             (do
               (fs/delete hook-path)
               (h/success "Pre-commit hook removed!"))
             (h/info "No pre-commit hook found")))}

  ;; =============================================================================
  ;; 📦 Dependencies & Build
  ;; =============================================================================

  clean
  {:doc "🧹 Clean build artifacts"
   :task (do
           (h/header "🧹 Cleaning Build Artifacts")
           (doseq [dir ["target" ".cpcache" "classes"]]
             (when (fs/exists? dir)
               (fs/delete-tree dir)
               (println (str "  Removed " dir))))
           (h/success "Cleaned!"))}

  deps
  {:doc "📦 Download and cache dependencies"
   :task (do
           (h/header "📦 Downloading Dependencies")
           (p/shell "clj" "-P")
           (p/shell "clj" "-P" "-M:dev")
           (h/success "Dependencies cached!"))}

  deps:tree
  {:doc "📦 Show dependency tree"
   :task (do
           (h/header "📦 Dependency Tree")
           (p/shell "clj" "-Stree"))}

  outdated
  {:doc "📦 Check for outdated dependencies"
   :task (do
           (h/header "🔍 Checking Outdated Dependencies")
           (p/shell {:continue true}
                    "clj" "-Sdeps"
                    "{:deps {com.github.liquidz/antq {:mvn/version \"RELEASE\"}}}"
                    "-M" "-m" "antq.core"))}

  ;; =============================================================================
  ;; 📊 Utilities
  ;; =============================================================================

  loc
  {:doc "📊 Count lines of code"
   :task (let [clj-files (fs/glob "src" "**/*.clj")
               lines (map (fn [f] (count (str/split-lines (slurp (str f))))) clj-files)
               total (reduce + 0 lines)]
           (h/header "📊 Lines of Code")
           (println (str "  Total lines: " (h/color h/green (str total))))
           (println (str "  Files: " (h/color h/cyan (str (count clj-files))))))}

  tree
  {:doc "📁 Show project structure"
   :task (do
           (h/header "📁 Project Structure")
           (p/shell "tree" "-I" "target|.git|.cpcache|classes" "-L" "3"))}

  ;; =============================================================================
  ;; 🍎 macOS Specific
  ;; =============================================================================

  macos:sign-lib
  {:doc "🍎 Sign raylib library for macOS"
   :task (do
           (h/header "🍎 Signing Raylib Library for macOS")
           (let [lib-path (str (first (fs/glob "libs/macos" "libraylib.*.dylib")))]
             (if (fs/exists? lib-path)
               (do
                 (p/shell "codesign" "--force" "--sign" "-" lib-path)
                 (h/success (str "Signed: " lib-path)))
               (h/error-msg (str "Library not found: " lib-path)))))}

  ;; =============================================================================
  ;; ❓ Help
  ;; =============================================================================

  ;; Re-reads this file with clojure.edn/read-string, so keep bb.edn free of
  ;; non-EDN reader macros (#"regex", @deref, #(...), see plan-authoring notes).
  info
  {:doc "🔍 Grouped cheat-sheet of every bb task (start here to review the project)"
   :task
   (let [tasks   (:tasks (edn/read-string (slurp "bb.edn")))
         brief   (fn [t]
                   (let [d (str/trim (str (:doc (get tasks (symbol t)))))]
                     (if (> (count d) 80) (str (subs d 0 79) "…") d)))
         sect    (fn [title] (println) (println (h/color h/magenta (str "── " title " ──"))))
         line    (fn [t]
                   (println (str "  " (h/color h/cyan (format "%-24s" (str "bb " t))) (brief t))))
         groups  [["🔧 Development"  ["repl" "nrepl"]]
                  ["🔍 Code quality" ["check" "check:full" "lint" "whitespace:check" "whitespace:fix"]]
                  ["🎨 LSP"          ["lsp:format" "lsp:format-check" "lsp:clean-ns"
                                      "lsp:clean-ns-check" "lsp:diagnostics" "lsp:check" "lsp:fix"]]
                  ["🪝 Git hooks"    ["hooks:install" "hooks:uninstall"]]
                  ["📦 Dependencies" ["deps" "deps:tree" "outdated"]]
                  ["🛠️ Utilities"    ["clean" "loc" "tree" "macos:sign-lib"]]
                  ["❓ Help"         ["help" "info"]]]
         grouped (into #{} (mapcat second groups))
         other   (->> (keys tasks) (filter symbol?) (map str) (remove grouped) sort)]
     (h/header "🎮 raylib-clj: task cheatsheet")
     (doseq [[title names] groups]
       (sect title)
       (doseq [t names :when (contains? tasks (symbol t))] (line t)))
     (when (seq other)
       (sect "Other (ungrouped)")
       (doseq [t other] (line t)))
     (println)
     (println "  Demos: https://github.com/b12n-oss/raylib-clj-demo · narrative help: `bb help` · flat task list: `bb tasks`"))}

  help
  {:doc "❓ Show help and available tasks"
   :override-builtin true
   :task (do
           (println)
           (println (h/color h/bold "🎮 raylib-clj"))
           (println "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
           (println "raylib bindings for Clojure over coffi and Panama FFI")
           (println)
           (println (h/color h/cyan "🔧 Development:"))
           (println "   bb repl             Start Clojure REPL")
           (println "   bb nrepl            Start nREPL on port 7999")
           (println)
           (println (h/color h/magenta "🎮 Demos:"))
           (println "   The example programs live in raylib-clj-demo:")
           (println "   https://github.com/b12n-oss/raylib-clj-demo")
           (println)
           (println (h/color h/yellow "🔍 Code Quality:"))
           (println "   bb check            ⭐ Fast check (compile + lint)")
           (println "   bb check:full       Comprehensive (+ LSP)")
           (println "   bb lint             Run clj-kondo")
           (println "   bb whitespace:check Check for trailing whitespace")
           (println "   bb whitespace:fix   Strip trailing whitespace")
           (println)
           (println (h/color h/green "🎨 LSP:"))
           (println "   bb lsp:format       Format all files")
           (println "   bb lsp:clean-ns     Clean namespace forms")
           (println "   bb lsp:fix          Auto-fix all")
           (println "   bb lsp:check        All LSP checks")
           (println)
           (println (h/color h/cyan "🛠️  Other:"))
           (println "   bb clean            Clean build artifacts")
           (println "   bb deps             Download dependencies")
           (println "   bb loc              Count lines of code")
           (println "   bb macos:sign-lib   Sign raylib for macOS")
           (println)
           (println "Run 'bb tasks' for complete task list"))}}}
